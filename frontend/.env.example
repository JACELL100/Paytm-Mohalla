# Mohalla web — copy to .env.local and fill in.

# FastAPI backend (backend/). Default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# true = run the whole demo on the built-in in-browser mock API (no backend needed).
# Can also be toggled at runtime: open any page with ?mocks=1 (or ?mocks=0 to turn off).
NEXT_PUBLIC_USE_MOCKS=false

# Supabase auth (optional). When unset, Google/email sign-in is hidden and only demo accounts show.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
