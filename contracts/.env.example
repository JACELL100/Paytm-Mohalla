# Sepolia deployment (python deploy.py --network sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
# Testnet-only key for a fresh wallet funded from a Sepolia faucet. Never reuse a real wallet.
DEPLOYER_PRIVATE_KEY=
# Optional: where the 1% Paytm fee goes (defaults to the deployer)
TREASURY_ADDRESS=
FEE_BPS=100

# Local (python deploy.py --network local) needs nothing: it uses anvil's first dev key.
