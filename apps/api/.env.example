# Mohalla API configuration. Copy to apps/api/.env (git-ignored). Every variable is optional:
# with no .env at all the API runs fully offline (SQLite, dev auth, no chain, no LLM).
# Only apps/api/.env is read (plus real environment variables, which win). The repo-root .env is NOT loaded.

# ---------------------------------------------------------------- database
# Default: local SQLite file apps/api/mohalla.db
DATABASE_URL=sqlite+aiosqlite:///./mohalla.db
# Supabase (production): use the *pooler* connection string (transaction mode, port 6543).
# statement caching is disabled automatically for asyncpg + PgBouncer.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_ECHO=false

# ---------------------------------------------------------------- auth
# AUTH_MODE defaults to "supabase" when SUPABASE_URL is set, else "dev" (tokens dev-merchant / dev-distributor / dev-ops)
# AUTH_MODE=dev
SUPABASE_URL=
# Sent as the `apikey` header when verifying a user's access token via GET {SUPABASE_URL}/auth/v1/user.
# Either name works: SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=
# Optional fallback for the apikey header. Either name works: SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- demo
DEMO_MODE=true
# Demo clock start (New Year week). now() = DEMO_NOW + elapsed real time x DEMO_CLOCK_RATE + Demo Director offset
DEMO_NOW=2026-12-26T09:00:00+05:30
# 1 = real time; 0 = frozen clock (handy while building the frontend: the 3-minute pool never expires)
DEMO_CLOCK_RATE=1
# Deadline of the seeded Cola 2L pool (minutes after reset) and of pools created by the pool engine
DEMO_POOL_DEADLINE_MINUTES=3
ENGINE_POOL_DEADLINE_MINUTES=120
# Background loops: relayer every RELAYER_INTERVAL_SECONDS, pool closer every JOB_INTERVAL_SECONDS
BACKGROUND_JOBS=true
JOB_INTERVAL_SECONDS=10
RELAYER_INTERVAL_SECONDS=0.5

# ---------------------------------------------------------------- AI (Groq, optional)
# Without a key: rule-based Hindi/Hinglish voice parser + template nudges; /health reports llm=false, stt=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Llama models are retired on Groq (2026); check console.groq.com/docs/models on the day
GROQ_MODEL_AGENT=openai/gpt-oss-120b
GROQ_MODEL_STT=whisper-large-v3
GROQ_MODEL_VISION=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------- blockchain
# off: txs are simulated (fake 0x hash after SIM_TX_DELAY_SECONDS); local: anvil; sepolia: Sepolia testnet
CHAIN_MODE=off
SIM_TX_DELAY_SECONDS=1.5
# local default http://127.0.0.1:8545. For sepolia set RPC_URL (or SEPOLIA_RPC_URL)
RPC_URL=
SEPOLIA_RPC_URL=
# Operator (pays all gas, mints tINR, relays signatures). local default = anvil key #0. REQUIRED for sepolia.
OPERATOR_PRIVATE_KEY=
# Shop + distributor wallets are HD-derived: m/44'/60'/0'/0/{100+shop_no} and {10000+n}.
# local default = anvil's "test test ... junk". REQUIRED for sepolia and must NOT be the anvil mnemonic:
# on Sepolia those public addresses carry EIP-7702 delegation code, so their signatures are rejected.
MERCHANT_MNEMONIC=
# Contract addresses come from app/chain/abi/deployment.<local|sepolia>.json (written by contracts/deploy.py);
# these override them
TINR_ADDRESS=
POOLS_ADDRESS=
TREASURY_ADDRESS=
FEE_BPS=100
EAS_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
EAS_SCHEMA_DELIVERY_UID=
EAS_SCHEMA_COMMITMENT_UID=

# ---------------------------------------------------------------- misc
QR_HMAC_SECRET=change-me
QR_TTL_MINUTES=10
# Extra CORS origins (comma separated). http://localhost:3000 is always allowed
FRONTEND_ORIGIN=
# Used to build absolute /static audio URLs
PUBLIC_API_URL=http://localhost:8000
